# Algorytm Prima – minimalne drzewo rozpinające (MST)
# Graf nieskierowany ważony, 5 węzłów (0-4)
# Macierz wag: 0 oznacza brak krawędzi
# Złożoność: O(V²) – wersja z tablicą kluczy

zmienna liczba N = 5

# Macierz wag (symetryczna):
#      0   1   2   3   4
# 0: [ 0,  2,  0,  6,  0 ]
# 1: [ 2,  0,  3,  8,  5 ]
# 2: [ 0,  3,  0,  0,  7 ]
# 3: [ 6,  8,  0,  0,  9 ]
# 4: [ 0,  5,  7,  9,  0 ]
zmienna lista wagi = [0, 2, 0, 6, 0, 2, 0, 3, 8, 5, 0, 3, 0, 0, 7, 6, 8, 0, 0, 9, 0, 5, 7, 9, 0]

# klucz[i]  = najmniejsza waga krawędzi łączącej i z aktualnym MST
# wMST[i]   = 1 jeśli węzeł i należy już do MST
# rodzic[i] = poprzednik węzła i w MST
zmienna lista klucz
zmienna lista wMST
zmienna lista rodzic

zmienna liczba INF = 999999
dla i od 0 do N - 1 {
    dodaj(klucz,  INF)
    dodaj(wMST,   0)
    dodaj(rodzic, 0 - 1)   # -1 = brak rodzica
}
klucz[0] = 0   # Startujemy od węzła 0

piszln("Algorytm Prima – krawedzie MST:")

zmienna liczba licznik = 0
dopóki (licznik < N) {
    # Znajdź węzeł u spoza MST o minimalnym kluczu
    zmienna liczba u = 0 - 1     # sentinel -1 = nie wybrano jeszcze
    zmienna liczba i = 0
    dopóki (i < N) {
        jeśli (wMST[i] == 0 oraz (u == 0 - 1 lub klucz[i] < klucz[u])) {
            u = i
        }
        i = i + 1
    }

    wMST[u] = 1   # Dodaj u do MST

    # Zaktualizuj klucze sąsiadów u
    zmienna liczba v = 0
    dopóki (v < N) {
        zmienna liczba kw = wagi[u * N + v]
        jeśli (kw != 0 oraz wMST[v] == 0 oraz kw < klucz[v]) {
            klucz[v]   = kw
            rodzic[v]  = u
        }
        v = v + 1
    }

    licznik = licznik + 1
}

# Wypisz krawędzie MST i ich wagi
zmienna liczba suma_mst = 0
dla i od 1 do N - 1 {
    pisz(rodzic[i])
    pisz(" -- ")
    pisz(i)
    pisz("  waga: ")
    piszln(klucz[i])
    suma_mst = suma_mst + klucz[i]
}
pisz("Laczna waga MST: ")
piszln(suma_mst)
